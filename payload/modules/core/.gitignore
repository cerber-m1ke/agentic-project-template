# The block between the agentic markers is managed by the template and replaced on update.
# agentic:begin
# Local runtime: uv, Python, caches, update staging (recreated by Toolbox/tb)
/Runtime/

# Resources: local clones and folders; only the description is committed
/Resources/*
!/Resources/README.md
!/Resources/resources.toml

# Agent adapters, generated by `Toolbox/tb agents link`
/.claude/
/.mcp.json
/.codex/
/CLAUDE.md

# Per-machine settings
/.agents/local.toml

# Obsidian workspace state and trash
/Knowledge/.obsidian/
/Knowledge/.trash/

# Secrets (example files stay committed)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Python bytecode
__pycache__/

# OS files
.DS_Store
Thumbs.db
._*
# agentic:end

# Project-specific rules go below this line.
# Editor settings (delete these lines to commit shared editor settings):
.idea/
.vscode/
