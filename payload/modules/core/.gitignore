# The block between the agentic markers is managed by the template and replaced on update.
# agentic:begin
# Local runtime: uv, Python, caches, update staging (recreated by Toolbox/tb)
/Runtime/

# Resources: local clones and folders; only the description is committed
/Resources/*
!/Resources/README.md
!/Resources/resources.toml

# Agent adapters, generated by `Toolbox/tb agents link`
/.claude/
/.mcp.json
/.codex/

# Per-machine settings
/.agents/local.toml

# Obsidian workspace state
/Knowledge/.obsidian/

# Secrets
.env
.env.*

# Python bytecode
__pycache__/

# OS and editor files
.DS_Store
Thumbs.db
._*
.idea/
.vscode/
# agentic:end

# Project-specific rules go below this line.
