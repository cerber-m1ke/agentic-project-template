# The block between the agentic markers is managed by the template and replaced on update.
# agentic:begin
# Line endings: LF everywhere, CRLF for Windows batch files (cmd.exe needs it).
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.docx binary
*.xlsx binary
*.pptx binary
# agentic:end

# Project-specific rules go below this line (e.g. Git LFS: *.psd filter=lfs diff=lfs merge=lfs -text).
